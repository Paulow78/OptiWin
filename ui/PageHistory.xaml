<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
    <TextBlock Text="Historique" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,16" Text="Tout ce qu'OptiWin a changé sur ce PC, et comment revenir en arrière."/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnRestorePoint" Content="Créer un point de restauration" Margin="0,0,8,0"/>
          <Button x:Name="BtnRstrui" Content="Restauration système" Margin="0,0,8,0"/>
          <Button x:Name="BtnUndoAll" Content="Tout annuler" Style="{StaticResource BtnDanger}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ActiveCount" Style="{StaticResource TxtMetric}" Text="0"/>
          <TextBlock Text="réglages actuellement appliqués" Style="{StaticResource TxtSmall}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock Text="Réglages appliqués" Style="{StaticResource TxtLabel}"/>
  </StackPanel>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,0,32,28">
      <ItemsControl x:Name="ActiveList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Row}" Padding="16,9">
              <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding Undo}" Padding="10,4">
                  <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoUndo}"/><TextBlock Text="Annuler" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Cat}" Style="{StaticResource TxtSmall}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="NoneText" Style="{StaticResource TxtMuted}" Text="Aucun réglage OptiWin n'est appliqué pour le moment." Margin="2,0,0,12"/>
      <TextBlock Text="Journal" Style="{StaticResource TxtLabel}" Margin="0,14,0,6"/>
      <ItemsControl x:Name="LogList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding When}" Style="{StaticResource TxtSmall}"/>
              <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TxtBody}"/>
              <TextBlock Grid.Column="2" Text="{Binding Action}" Style="{StaticResource TxtSmall}" Margin="12,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</DockPanel>
