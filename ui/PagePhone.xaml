<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="32,22,32,32">
    <TextBlock Text="Téléphone Android" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,18" Text="Débloatez, nettoyez et accélérez votre smartphone Android par câble USB ou en Wi-Fi (Samsung, Xiaomi, Oppo, OnePlus, Motorola…). Tout est réversible et les fonctions vitales sont protégées."/>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Connexion USB ou Wi-Fi -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,11,0">
              <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPhone}" TextElement.Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="1. Connecter le téléphone (USB ou Wi-Fi)" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="PhoneModeUsb" Style="{StaticResource Pill}" GroupName="PhoneConnMode" Content="Câble USB" IsChecked="True"/>
            <RadioButton x:Name="PhoneModeWifi" Style="{StaticResource Pill}" GroupName="PhoneConnMode" Content="Wi-Fi / Réseau"/>
          </StackPanel>

          <!-- Mode USB -->
          <StackPanel x:Name="PanelPhoneUsb">
            <TextBlock Style="{StaticResource TxtSmall}" Margin="0,0,0,3" Text="Sur le téléphone, une seule fois :"/>
            <TextBlock Style="{StaticResource TxtSmall}" Margin="8,0,0,2" Text="•  Paramètres › À propos du téléphone : appuyez 7 fois sur « Numéro de build » (ou Version MIUI/HyperOS)."/>
            <TextBlock Style="{StaticResource TxtSmall}" Margin="8,0,0,10" Text="•  Options développeurs : activez « Débogage USB », puis branchez le câble et validez l'autorisation."/>
            <WrapPanel>
              <Button x:Name="BtnPhoneConnectUsb" Style="{StaticResource BtnPrimary}" Content="Connecter en USB" Margin="0,0,8,6" Padding="20,8"/>
              <Button x:Name="BtnPhoneToWifi" Margin="0,0,0,6" IsEnabled="False" ToolTip="Bascule le téléphone connecté en USB vers le Wi-Fi (port 5555) pour pouvoir débrancher le câble">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoWifi}"/><TextBlock Text="Passer en Wi-Fi" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <!-- Mode Wi-Fi / Réseau -->
          <StackPanel x:Name="PanelPhoneWifi" Visibility="Collapsed">
            <TextBlock Style="{StaticResource TxtSmall}" Margin="0,0,0,8" Text="Android 11+ : Options développeurs › Débogage sans fil › Associer un appareil avec un code (une seule fois), puis connectez avec l'IP:port affichée."/>
            <TextBlock Text="Adresse IP et port du téléphone" Style="{StaticResource TxtLabel}"/>
            <TextBox x:Name="PhoneHost" Tag="Ex. 192.168.1.25:41234 (ou 192.168.1.25 si port 5555)"/>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="BtnPhoneConnectWifi" Style="{StaticResource BtnPrimary}" Content="Connecter en Wi-Fi" Margin="0,0,8,6" Padding="18,8"/>
              <Button x:Name="BtnPhoneScan" Margin="0,0,8,6" ToolTip="Cherche les appareils Android ouverts sur le port 5555 du réseau local">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSearch}"/><TextBlock Text="Scanner le réseau" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="BtnPhonePairToggle" Style="{StaticResource BtnGhost}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoKey}"/><TextBlock Text="Appairer (code 6 chiffres)" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </WrapPanel>
            <Border x:Name="PhonePairBox" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Appairage sans fil (Android 11+)" Style="{StaticResource TxtBody}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="PhonePairHost" Tag="IP:port d'appairage"/>
                  <TextBox x:Name="PhonePairCode" Grid.Column="2" Tag="Code 6 chiffres" MaxLength="6"/>
                  <Button x:Name="BtnPhonePair" Grid.Column="4" Content="Appairer" Padding="14,8"/>
                </Grid>
              </StackPanel>
            </Border>
            <ComboBox x:Name="PhoneFound" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>

          <TextBlock x:Name="PhoneStatus" Style="{StaticResource TxtSmallAuto}" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <!-- État du smartphone connecté -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <StackPanel x:Name="PhoneDeviceCard" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,10">
              <Button x:Name="BtnPhoneQuickOpt" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Padding="14,7" ToolTip="Allège les bloatwares recommandés, accélère les animations (0,5×), vide les caches et ferme l'arrière-plan">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoZap}"/><TextBlock Text="Optimiser en 1 clic" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,11,0">
                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPhone}" TextElement.Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="PhoneName" Style="{StaticResource TxtH2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ItemsControl x:Name="PhoneFacts">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource TxtBody}" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding Key}" Style="{StaticResource TxtSmall}" VerticalAlignment="Center"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="BtnPhoneCaches" Margin="0,0,8,6" ToolTip="Vide les caches temporaires des applications sur tout le téléphone">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSpark}"/><TextBlock Text="Vider les caches" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="BtnPhoneKill" Margin="0,0,8,6" ToolTip="Ferme les applications inactives en arrière-plan">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoLayers}"/><TextBlock Text="Fermer l'arrière-plan" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="BtnPhoneShot" Margin="0,0,8,6" ToolTip="Capture l'écran du téléphone en PNG">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoCamera}"/><TextBlock Text="Capture" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="BtnPhoneReboot" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoPower}"/><TextBlock Text="Redémarrer" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel VerticalAlignment="Center" Margin="0,18">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Visibility, ElementName=PhoneDeviceCard}" Value="Collapsed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Path Style="{StaticResource IcoLg}" Data="{StaticResource IcoPhone}" TextElement.Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
            <TextBlock Text="Aucun smartphone connecté" Style="{StaticResource TxtBody}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,2"/>
            <TextBlock Style="{StaticResource TxtSmall}" TextAlignment="Center" Text="Branchez votre téléphone en USB ou connectez-le en Wi-Fi : OptiTech lit sa batterie, sa mémoire, son stockage et propose un débloatage sûr et réversible."/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Espace de travail une fois connecté -->
    <StackPanel x:Name="PhoneWorkspace" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <RadioButton x:Name="TabPhoneDebloat" Style="{StaticResource Pill}" GroupName="PhoneTabs" Content="Débloatage &amp; Rétablissement" IsChecked="True"/>
        <RadioButton x:Name="TabPhoneTune" Style="{StaticResource Pill}" GroupName="PhoneTabs" Content="Fluidité, DNS anti-pub &amp; ART"/>
        <RadioButton x:Name="TabPhoneApps" Style="{StaticResource Pill}" GroupName="PhoneTabs" Content="Applications installées"/>
      </StackPanel>

      <!-- Onglet 1 : Débloatage -->
      <StackPanel x:Name="PanelPhoneDebloat">
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPhoneRec" Style="{StaticResource BtnGhost}" Content="Recommandés" Margin="0,0,2,0"/>
                <Button x:Name="BtnPhoneAll" Style="{StaticResource BtnGhost}" Content="Tout" Margin="0,0,2,0"/>
                <Button x:Name="BtnPhoneNone" Style="{StaticResource BtnGhost}" Content="Aucun" Margin="0,0,8,0"/>
                <Button x:Name="BtnPhoneAnalyze" Margin="0,0,8,0" ToolTip="F5">
                  <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Analyser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="BtnPhoneClean" Style="{StaticResource BtnPrimary}" Padding="18,8" IsEnabled="False">
                  <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSpark}"/><TextBlock Text="Alléger la sélection" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PhonePlanTitle" Text="2. Bloatwares détectés sur ce smartphone" Style="{StaticResource TxtH2}"/>
                <TextBlock x:Name="PhonePlanSub" Style="{StaticResource TxtSmall}"/>
              </StackPanel>
            </DockPanel>
            <TextBox x:Name="PhonePlanSearch" Tag="Filtrer par marque, nom ou paquet…" Margin="0,0,0,10"/>
            <ItemsControl x:Name="PhonePlan">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,0,0,5">
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TxtSmall}"/>
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <StackPanel><ContentPresenter/><ItemsPresenter/></StackPanel>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource TxtLabel}" Margin="2,10,0,7"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Button x:Name="BtnPhoneRestore" DockPanel.Dock="Right" VerticalAlignment="Center" IsEnabled="False">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoUndo}"/><TextBlock Text="Tout rétablir" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="3. Allégé par OptiTech sur ce smartphone" Style="{StaticResource TxtH2}"/>
                <TextBlock Style="{StaticResource TxtSmall}" Text="Chaque application désactivée ou retirée pour l'utilisateur 0 est mémorisée ici et se rétablit en un clic."/>
              </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="PhoneDisabled">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" CornerRadius="11" Padding="12,7" Margin="0,0,0,5">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Command="{Binding Enable}" Content="Rétablir" Padding="10,4"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Package}" Style="{StaticResource TxtSmall}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="PhoneDisabledEmpty" Style="{StaticResource TxtMuted}" Text="Rien pour le moment."/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Onglet 2 : Fluidité, DNS & ART -->
      <StackPanel x:Name="PanelPhoneTune" Visibility="Collapsed">
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,11,0">
                  <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSliders}" TextElement.Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Vitesse des animations" Style="{StaticResource TxtH2}"/>
                  <TextBlock x:Name="PhoneAnimInfo" Style="{StaticResource TxtSmall}" Text="Rend l'interface beaucoup plus réactive, surtout sur les appareils anciens."/>
                </StackPanel>
              </DockPanel>
              <UniformGrid Columns="4" Margin="0,4,0,0">
                <Button x:Name="BtnPhoneAnim1" Content="1× Origine" Margin="0,0,6,0" Padding="8,9"/>
                <Button x:Name="BtnPhoneAnim05" Content="0,5× Rapide" Margin="0,0,6,0" Padding="8,9"/>
                <Button x:Name="BtnPhoneAnim025" Content="0,25× Ultra" Margin="0,0,6,0" Padding="8,9"/>
                <Button x:Name="BtnPhoneAnim0" Content="0× Instant." Padding="8,9"/>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,11,0">
                  <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShield}" TextElement.Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DNS privé anti-pub &amp; rapide (Android 9+)" Style="{StaticResource TxtH2}"/>
                  <TextBlock x:Name="PhoneDnsInfo" Style="{StaticResource TxtSmall}" Text="Bloque les publicités dans le navigateur et les apps sans VPN."/>
                </StackPanel>
              </DockPanel>
              <WrapPanel Margin="0,4,0,0">
                <Button x:Name="BtnPhoneDnsAdguard" Content="AdGuard (anti-pub)" Margin="0,0,8,6" Padding="12,8"/>
                <Button x:Name="BtnPhoneDnsCf" Content="Cloudflare (1.1.1.1)" Margin="0,0,8,6" Padding="12,8"/>
                <Button x:Name="BtnPhoneDnsQuad9" Content="Quad9 (sécurité)" Margin="0,0,8,6" Padding="12,8"/>
                <Button x:Name="BtnPhoneDnsAuto" Content="Automatique" Margin="0,0,0,6" Padding="12,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button x:Name="BtnPhoneDexOpt" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Padding="16,9">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoZap}"/><TextBlock Text="Optimiser ART" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Optimiser les applications (ART / DEX)" Style="{StaticResource TxtH2}"/>
                <TextBlock Style="{StaticResource TxtSmall}" Margin="0,4,0,0" Text="Recompile les profils d'applications Android : lancements plus rapides et meilleure autonomie après une mise à jour."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
              <Button x:Name="BtnPhoneApk" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center" Margin="14,0,0,0" Padding="16,9">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoUpload}"/><TextBlock Text="Installer un APK…" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Installer une application (.apk)" Style="{StaticResource TxtH2}"/>
                <TextBlock Style="{StaticResource TxtSmall}" Margin="0,4,0,0" Text="Installe directement un fichier .apk depuis votre PC sur le smartphone connecté."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Onglet 3 : Applications tierces -->
      <StackPanel x:Name="PanelPhoneApps" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Button x:Name="BtnPhoneAppsRefresh" DockPanel.Dock="Right" Padding="12,6">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Actualiser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Applications tierces installées" Style="{StaticResource TxtH2}"/>
                <TextBlock x:Name="PhoneAppsSub" Style="{StaticResource TxtSmall}" Text="Forcez l'arrêt d'une application qui consomme batterie ou mémoire en arrière-plan."/>
              </StackPanel>
            </DockPanel>
            <TextBox x:Name="PhoneAppsSearch" Tag="Rechercher un paquet installé…" Margin="0,0,0,10"/>
            <ItemsControl x:Name="PhoneThirdApps">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,0,4">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Command="{Binding Stop}" Content="Forcer l'arrêt" Padding="10,4"/>
                      <TextBlock Text="{Binding Package}" Style="{StaticResource TxtBody}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="PhoneAppsEmpty" Style="{StaticResource TxtMuted}" Text="Aucune application tierce listée." Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ScrollViewer>
