<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiTech" Width="1200" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WinBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource FontText}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
   <!-- Scène : tout ce qui se floute quand un dialogue s'ouvre par-dessus -->
   <Grid x:Name="Stage">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Halos de couleur (nébuleuse sombre) : mis en cache GPU une seule fois pour rester ultra-fluide -->
    <Grid x:Name="AmbientLayer" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
      <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
      <Ellipse Width="740" Height="740" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-260,0,0" Fill="{DynamicResource AmbientA}"/>
      <Ellipse Width="860" Height="860" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-290,-340" Fill="{DynamicResource AmbientB}"/>
      <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-240,80,0" Fill="{DynamicResource AmbientC}"/>
      <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="140,0,0,-240" Fill="{DynamicResource AmbientD}"/>
      <Ellipse Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="120,-80,0,0" Fill="{DynamicResource AmbientE}"/>
    </Grid>

    <!-- Barre latérale -->
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,0,12,14">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,18,0,10" ToolTipService.InitialShowDelay="600">
            <StackPanel.ToolTip>
              <TextBlock>
                <Run Text="Raccourcis clavier" FontWeight="SemiBold"/><LineBreak/>
                <Run Text="Ctrl+K : recherche rapide et commandes"/><LineBreak/>
                <Run Text="Ctrl+1 à Ctrl+0 : changer de page"/><LineBreak/>
                <Run Text="F5 : actualiser la page"/><LineBreak/>
                <Run Text="Ctrl+F : chercher dans la page"/><LineBreak/>
                <Run Text="Ctrl+T : changer de thème"/><LineBreak/>
                <Run Text="Échap : fermer un dialogue"/>
              </TextBlock>
            </StackPanel.ToolTip>
            <!-- Logo : pastille de verre teintée, reflet en haut, éclair blanc -->
            <Grid Width="36" Height="36">
              <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
              <Border CornerRadius="11" Background="{DynamicResource LogoGradient}">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.48" Color="#4B93FF"/></Border.Effect>
              </Border>
              <Border CornerRadius="11" BorderBrush="#88FFFFFF" BorderThickness="1"/>
              <Border CornerRadius="10,10,16,16" Margin="2,2,2,17" Background="{DynamicResource GlassSheen}"/>
              <Path Data="{StaticResource IcoZap}" Width="24" Height="24" Stretch="None" Fill="White" Stroke="White" StrokeThickness="1.2" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path.LayoutTransform><ScaleTransform ScaleX="0.74" ScaleY="0.74"/></Path.LayoutTransform>
              </Path>
            </Grid>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="OptiTech" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              <TextBlock x:Name="VersionText" Text="26.11.4" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,-2,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Accès rapide à la palette de commandes -->
          <Button x:Name="BtnPalette" Margin="0,2,0,10" Padding="11,7" HorizontalContentAlignment="Stretch" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" ToolTip="Ouvrir la recherche rapide (Ctrl+K)">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource KbdBadge}">
                <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
              </Border>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSearch}" TextElement.Foreground="{DynamicResource TextFaint}"/>
                <TextBlock Text="Rechercher…" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="AdminBadge" CornerRadius="10" Padding="11,8" Margin="0,0,0,6" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Mode limité" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"/>
              <TextBlock Text="Lecture seule pour la plupart des réglages." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,1,0,5"/>
              <Button x:Name="BtnElevate" Content="Passer administrateur" Padding="8,4" FontSize="12"/>
            </StackPanel>
          </Border>
          <!-- Nouvelle version publiée sur GitHub -->
          <Button x:Name="BtnUpdate" Visibility="Collapsed" Margin="0,0,0,6" Padding="11,8" HorizontalContentAlignment="Left" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource GlassBorder}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoArrowUp}" TextElement.Foreground="{DynamicResource Accent}"/>
              <StackPanel Margin="9,0,0,0">
                <TextBlock Text="Mise à jour disponible" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="UpdateLabel" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="BtnTheme" Style="{StaticResource BtnGhost}" HorizontalContentAlignment="Left" Padding="13,8" ToolTip="Ctrl+T">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="ThemeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoSun}"/>
              <TextBlock x:Name="ThemeLabel" Text="Thème clair" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Le menu défile si la fenêtre est basse : rien n'est jamais coupé -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-4,0" Padding="0,0,4,0">
          <StackPanel x:Name="Nav">
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav" Content="Accueil" Tag="{StaticResource IcoGauge}" ToolTip="Ctrl+1"/>
            <TextBlock Text="ENTRETENIR" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" GroupName="Nav" Content="Optimiser" Tag="{StaticResource IcoZap}" ToolTip="Ctrl+2"/>
            <RadioButton x:Name="NavClean" Style="{StaticResource NavItem}" GroupName="Nav" Content="Nettoyer" Tag="{StaticResource IcoSpark}" ToolTip="Ctrl+3"/>
            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" GroupName="Nav" Content="Démarrage" Tag="{StaticResource IcoPower}" ToolTip="Ctrl+4"/>
            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" GroupName="Nav" Content="Applications" Tag="{StaticResource IcoGrid}" ToolTip="Ctrl+5"/>
            <TextBlock Text="ANDROID" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavTv" Style="{StaticResource NavItem}" GroupName="Nav" Content="Téléviseur" Tag="{StaticResource IcoTv}" ToolTip="Android TV et Google TV"/>
            <RadioButton x:Name="NavPhone" Style="{StaticResource NavItem}" GroupName="Nav" Content="Téléphone" Tag="{StaticResource IcoPhone}" ToolTip="Smartphone Android (USB ou Wi-Fi)"/>
            <TextBlock Text="INSTALLER" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavReinstall" Style="{StaticResource NavItem}" GroupName="Nav" Content="Réinstaller" Tag="{StaticResource IcoPackage}" ToolTip="Ctrl+6"/>
            <RadioButton x:Name="NavUsb" Style="{StaticResource NavItem}" GroupName="Nav" Content="USB et ISO" Tag="{StaticResource IcoUsb}" ToolTip="Ctrl+7"/>
            <TextBlock Text="COMPRENDRE" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavDiagnostic" Style="{StaticResource NavItem}" GroupName="Nav" Content="Diagnostic" Tag="{StaticResource IcoActivity}" ToolTip="Ctrl+8"/>
            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav" Content="Outils" Tag="{StaticResource IcoTool}" ToolTip="Ctrl+9"/>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" Content="Historique" Tag="{StaticResource IcoClock}" ToolTip="Ctrl+0"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Contenu -->
    <Border Grid.Column="1" x:Name="ContentPanel" Margin="0,38,0,0" CornerRadius="22,0,0,0" Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1,1,0,0" ClipToBounds="True">
      <ContentControl x:Name="PageHost" Focusable="False">
        <ContentControl.RenderTransform><TranslateTransform x:Name="PageTx" Y="0"/></ContentControl.RenderTransform>
      </ContentControl>
    </Border>
   </Grid>

    <!-- Boutons de fenêtre (remplacés par ceux de Windows quand Mica est actif) -->
    <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="50">
      <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" ToolTip="Réduire"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoMinus}"/></Button>
      <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" ToolTip="Agrandir"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSquare}"/></Button>
      <Button x:Name="BtnClose" Style="{StaticResource CaptionClose}" ToolTip="Fermer"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoX}"/></Button>
    </StackPanel>

    <!-- Palette de commandes (Ctrl+K) -->
    <Grid x:Name="PaletteLayer" Style="{StaticResource Scrim}" Panel.ZIndex="25">
      <Border Style="{StaticResource Dialog}" Width="600" MaxHeight="520" Padding="18" VerticalAlignment="Top" Margin="0,84,0,0">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="PaletteInput" FontSize="14.5" Padding="36,10,12,10" Tag="Aller à une page, un réglage, un outil ou une action…"/>
            <Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSearch}" TextElement.Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
          </Grid>
          <DockPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
            <TextBlock x:Name="PaletteCount" DockPanel.Dock="Right" Style="{StaticResource TxtSmall}" Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Style="{StaticResource TxtSmall}" Foreground="{DynamicResource TextFaint}" Text="↑↓ naviguer  ·  Entrée exécuter  ·  Échap fermer"/>
          </DockPanel>
          <Grid>
            <ListBox x:Name="PaletteList" Background="Transparent" BorderThickness="0" MaxHeight="360"
                     ItemContainerStyle="{StaticResource PaletteItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource ChipBase}" Background="{DynamicResource KbdBg}" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource ChipText}" Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IcoSm}" Data="{Binding IconGeo}" TextElement.Foreground="{DynamicResource Accent}" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource TxtSmallAuto}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="PaletteEmpty" Style="{StaticResource TxtEmpty}" Text="Aucun résultat." Margin="0,24"/>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Confirmation -->
    <Grid x:Name="ConfirmLayer" Style="{StaticResource Scrim}" Panel.ZIndex="20">
      <Border Style="{StaticResource Dialog}" Width="500">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <StackPanel>
          <TextBlock x:Name="ConfirmTitle" Style="{StaticResource TxtH2}" FontSize="18" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmBody" Style="{StaticResource TxtMuted}" Margin="0,10,0,0"/>
          <StackPanel x:Name="ConfirmTyped" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ConfirmTypedLabel" Style="{StaticResource TxtLabel}"/>
            <TextBox x:Name="ConfirmInput"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfirmNo" Content="Annuler" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="ConfirmYes" Content="Confirmer" Style="{StaticResource BtnPrimary}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Plan d'optimisation -->
    <Grid x:Name="PlanLayer" Style="{StaticResource Scrim}" Panel.ZIndex="20">
      <Border Style="{StaticResource Dialog}" Width="660" MaxHeight="660">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="PlanTitle" Style="{StaticResource TxtH2}" FontSize="20"/>
            <TextBlock x:Name="PlanSub" Style="{StaticResource TxtMuted}" Margin="0,5,0,14"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <CheckBox x:Name="PlanRestore" Content="Créer d'abord un point de restauration Windows" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="PlanClean" Content="Nettoyer aussi les fichiers temporaires et les caches" IsChecked="True"/>
            <DockPanel Margin="0,18,0,0">
              <TextBlock x:Name="PlanCount" DockPanel.Dock="Left" Style="{StaticResource TxtSmall}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PlanNo" Content="Annuler" Margin="0,0,8,0"/>
                <Button x:Name="PlanYes" Content="Appliquer" Style="{StaticResource BtnPrimary}" Padding="20,9"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
          <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource SurfaceAlt}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
              <ItemsControl x:Name="PlanList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Tweak.CanToggle}" Margin="10,8" ToolTip="{Binding Tweak.ToolTipText}" ToolTipService.ShowOnDisabled="True">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource RiskChip}" DataContext="{Binding Tweak}" Margin="10,0,0,0">
                          <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/>
                        </Border>
                        <Border DockPanel.Dock="Right" Style="{StaticResource ChipBase}" Background="{DynamicResource HoverLayer}" Margin="10,0,0,0" DataContext="{Binding Tweak}" Visibility="{Binding HasEffect, Converter={StaticResource BoolVis}}">
                          <TextBlock Text="{Binding EffectLabel}" Style="{StaticResource ChipText}" Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                        <TextBlock Text="{Binding Tweak.TitleText}" Style="{StaticResource TxtBody}"/>
                      </DockPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Tâche en cours -->
    <Grid x:Name="JobLayer" Style="{StaticResource Scrim}" Panel.ZIndex="30">
      <Border Style="{StaticResource Dialog}" Width="760" Height="540">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="JobTitle" Style="{StaticResource TxtH2}" FontSize="20" TextTrimming="CharacterEllipsis"/>
            <DockPanel Margin="0,6,0,10">
              <TextBlock x:Name="JobDetail" DockPanel.Dock="Right" Style="{StaticResource TxtSmall}" Margin="12,0,0,0"/>
              <TextBlock x:Name="JobStatus" Style="{StaticResource TxtMuted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
            <ProgressBar x:Name="JobBar" Maximum="100" IsIndeterminate="True" Margin="0,0,0,14"/>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="JobCancel" Content="Annuler" Margin="0,0,8,0"/>
              <Button x:Name="JobClose" Content="Fermer" Style="{StaticResource BtnPrimary}" IsEnabled="False" Padding="22,8"/>
            </StackPanel>
            <TextBlock x:Name="JobResult" Style="{StaticResource TxtBody}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBox x:Name="JobLog" IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Message éphémère -->
    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" CornerRadius="14" Padding="16,10"
            Background="{DynamicResource DialogBg}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" Visibility="Collapsed" Panel.ZIndex="40" IsHitTestVisible="False" MaxWidth="700">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black"/></Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="ToastText" Style="{StaticResource TxtBody}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
