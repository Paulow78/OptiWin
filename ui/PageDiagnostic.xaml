<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="32,22,32,32">
    <TextBlock Text="Diagnostic" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,18" Text="Des chiffres plutôt qu'une impression : ce que les optimisations ont vraiment changé, et l'état réel de vos disques."/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnClearMetrics" Content="Tout effacer" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"/>
            <Button x:Name="BtnMeasure" Style="{StaticResource BtnPrimary}" Padding="16,8">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoActivity}"/><TextBlock Text="Mesurer maintenant" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="Avant et après" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Référence" Style="{StaticResource TxtLabel}"/>
            <ComboBox x:Name="BaseCombo"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Comparer à" Style="{StaticResource TxtLabel}"/>
            <ComboBox x:Name="AfterCombo"/>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="MetricEmpty" Style="{StaticResource TxtMuted}" Text="Aucune mesure pour l'instant. Une mesure est prise automatiquement avant chaque profil appliqué, et vous pouvez en lancer une à tout moment."/>

        <StackPanel x:Name="MetricTable" Visibility="Collapsed">
          <Grid Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Référence" Style="{StaticResource TxtSmall}" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="Comparaison" Style="{StaticResource TxtSmall}" TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="Écart" Style="{StaticResource TxtSmall}" TextAlignment="Right"/>
          </Grid>
          <ItemsControl x:Name="MetricRows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource TxtBody}" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding After}" Style="{StaticResource TxtBody}" TextAlignment="Right"/>
                    <TextBlock x:Name="D" Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="ok"><Setter TargetName="D" Property="Foreground" Value="{DynamicResource Ok}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="warn"><Setter TargetName="D" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="MetricNote" Style="{StaticResource TxtSmall}" Margin="2,8,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Programmes les plus gourmands en mémoire -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button x:Name="BtnProcs" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" ToolTip="F5">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Actualiser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <TextBlock Text="Ce qui occupe la mémoire en ce moment" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl x:Name="ProcList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Value="{Binding Share, Mode=OneWay}" Maximum="100" Margin="12,0" Foreground="{DynamicResource Info}"/>
                <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource TxtSmall}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ProcStatus" Style="{StaticResource TxtSmallAuto}" Margin="2,6,0,0"/>
      </StackPanel>
    </Border>

    <DockPanel Margin="2,0,0,10">
      <Button x:Name="BtnDisks" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Actualiser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <TextBlock Text="Santé des disques" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="DiskStatus" Style="{StaticResource TxtSmallAuto}" Margin="2,0,0,10"/>
    <ItemsControl x:Name="DiskList" Margin="0,0,-14,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource LevelDot}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtRow}"/>
                  <TextBlock Text="{Binding Sub}" Style="{StaticResource TxtSmall}"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource TxtBody}" Margin="0,10,0,10"/>
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,3">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource TxtBody}" Margin="10,0,0,0"/>
                      <TextBlock Text="{Binding Key}" Style="{StaticResource TxtSmall}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</ScrollViewer>
