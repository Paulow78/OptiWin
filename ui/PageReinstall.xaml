<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="32,22,32,32">
    <TextBlock Text="Réinstaller" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,18" Text="Emportez vos réglages et vos logiciels vers un Windows neuf, puis retrouvez-les en quelques clics."/>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button x:Name="BtnExport" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="18,9">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoDownload}"/><TextBlock Text="Créer le profil" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="1. Avant de réinstaller" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,5,0,0" Text="Crée un petit fichier avec vos réglages, vos logiciels et ce que vous avez coupé au démarrage. Il ne contient ni fichier personnel ni mot de passe. Gardez-le sur une clé USB."/>
            <TextBlock x:Name="ExportInfo" Style="{StaticResource TxtSmallAuto}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <Button x:Name="BtnImport" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="18,9">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoFolder}"/><TextBlock Text="Ouvrir un profil" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="2. Sur le Windows neuf" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,5,0,0" Text="OptiWin compare le profil à ce PC et ne propose que ce qui changerait vraiment. Vous cochez, il applique. Rien ne se fait sans votre accord."/>
            <TextBlock x:Name="ImportInfo" Style="{StaticResource TxtSmallAuto}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <Border x:Name="PlanCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button x:Name="BtnApply" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Appliquer la sélection" Padding="18,8"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PlanTitle" Style="{StaticResource TxtH2}"/>
            <TextBlock x:Name="PlanSub" Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
        <CheckBox x:Name="ChkRestore" Content="Créer d'abord un point de restauration Windows" IsChecked="True" Margin="0,0,0,10"/>
        <ItemsControl x:Name="PlanRows">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmallAuto}"/>
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel><ContentPresenter/><ItemsPresenter/></StackPanel>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtLabel}" Margin="2,10,0,7"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ItemsControl.GroupStyle>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="20,14">
      <DockPanel>
        <Button x:Name="BtnDrivers" DockPanel.Dock="Right" Content="Ouvrir les outils" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Pensez aussi à vos pilotes" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
          <TextBlock Text="Le profil ne les contient pas. « Sauvegarder les pilotes » les copie dans un dossier, pour les réinjecter après l'installation." Style="{StaticResource TxtSmall}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
