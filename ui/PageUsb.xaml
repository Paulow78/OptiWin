<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
    <TextBlock Text="USB et ISO" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,14" Text="Créez une clé d'installation, une image ISO ou une version allégée de Windows."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <RadioButton x:Name="TabFlash" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="Clé bootable" IsChecked="True"/>
      <RadioButton x:Name="TabIso" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="Créer une ISO"/>
      <RadioButton x:Name="TabCustom" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="ISO personnalisée"/>
      <RadioButton x:Name="TabMulti" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="Multiboot"/>
      <RadioButton x:Name="TabDownload" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="Télécharger"/>
      <RadioButton x:Name="TabHash" Style="{StaticResource Pill}" GroupName="UsbTabs" Content="Vérifier"/>
    </StackPanel>
  </StackPanel>

  <Grid>
    <!-- ═══════ Clé bootable ═══════ -->
    <ScrollViewer x:Name="PanelFlash" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid Margin="32,0,32,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="1. Image" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
              <DockPanel>
                <Button x:Name="BtnPickImage" DockPanel.Dock="Right" Content="Parcourir" Margin="8,0,0,0"/>
                <TextBox x:Name="ImagePath" Tag="Fichier .iso ou .img" IsReadOnly="True"/>
              </DockPanel>
              <TextBlock x:Name="ImageInfo" Style="{StaticResource TxtSmall}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="2. Clé USB" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
              <DockPanel>
                <Button x:Name="BtnRefreshDisks" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Actualiser" Padding="10,8"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/></Button>
                <ComboBox x:Name="DiskCombo"/>
              </DockPanel>
              <CheckBox x:Name="ChkExternal" Content="Afficher aussi les disques durs externes USB" Margin="0,10,0,0"/>
              <TextBlock x:Name="DiskInfo" Style="{StaticResource TxtSmall}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="3. Mode" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
              <RadioButton x:Name="ModeMbr" Style="{StaticResource ChoiceCard}" GroupName="Mode" Margin="0,0,0,6" IsChecked="True">
                <StackPanel><TextBlock Text="Windows : UEFI et ancien BIOS" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/><TextBlock Text="MBR + FAT32. Démarre sur presque tous les PC, vieux compris." Style="{StaticResource TxtSmall}"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeGpt" Style="{StaticResource ChoiceCard}" GroupName="Mode" Margin="0,0,0,6">
                <StackPanel><TextBlock Text="Windows : UEFI uniquement" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/><TextBlock Text="GPT + FAT32. Pour les PC récents." Style="{StaticResource TxtSmall}"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeRaw" Style="{StaticResource ChoiceCard}" GroupName="Mode">
                <StackPanel><TextBlock Text="Image brute (DD)" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/><TextBlock Text="Pour Linux et les outils de secours : copie exacte de l'image, secteur par secteur." Style="{StaticResource TxtSmall}"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border x:Name="WinOptions" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="4. Options de Windows" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
              <CheckBox x:Name="ChkBypassHw" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Autoriser les PC non compatibles Windows 11" Style="{StaticResource TxtBody}"/><TextBlock Text="Retire les blocages TPM, Secure Boot, RAM et processeur. Microsoft ne garantit pas les mises à jour sur ces PC." Style="{StaticResource TxtSmall}"/></StackPanel>
              </CheckBox>
              <CheckBox x:Name="ChkBypassAcct" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Sans compte Microsoft ni Internet obligatoires" Style="{StaticResource TxtBody}"/></StackPanel>
              </CheckBox>
              <CheckBox x:Name="ChkLocal" Margin="0,0,0,6">
                <StackPanel><TextBlock Text="Créer directement ce compte local" Style="{StaticResource TxtBody}"/><TextBlock Text="Compte administrateur sans mot de passe, à définir après l'installation." Style="{StaticResource TxtSmall}"/></StackPanel>
              </CheckBox>
              <TextBox x:Name="TxtLocal" Tag="Nom du compte" Margin="29,0,0,10" IsEnabled="False"/>
              <CheckBox x:Name="ChkNoBitlocker" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Ne pas chiffrer automatiquement le disque" Style="{StaticResource TxtBody}"/><TextBlock Text="Plus rapide sur un vieux PC, mais les données ne sont plus protégées si le PC est volé." Style="{StaticResource TxtSmall}"/></StackPanel>
              </CheckBox>
              <CheckBox x:Name="ChkPrivacy" Content="Refuser d'emblée les options de collecte de données" Margin="0,0,0,10"/>
              <CheckBox x:Name="ChkCopyOpti" Content="Copier OptiWin et le kit de secours sur la clé" IsChecked="True"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="ChkVerify" Content="Vérifier après l'écriture" IsChecked="True" Margin="0,0,0,14"/>
              <Button x:Name="BtnFlash" Style="{StaticResource BtnDanger}" FontSize="14" Padding="14,12">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoUsb}"/><TextBlock Text="Créer la clé" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <TextBlock Style="{StaticResource TxtSmall}" Margin="0,10,0,0" TextAlignment="Center" Text="Toutes les données de la clé seront effacées. Le disque système n'est jamais proposé."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ═══════ Créer une ISO ═══════ -->
    <ScrollViewer x:Name="PanelIso" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="32,0,32,28" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="600">
        <StackPanel>
          <TextBlock Text="Créer une ISO à partir d'un dossier ou d'une clé" Style="{StaticResource TxtH2}"/>
          <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,16" Text="Si la source contient les fichiers de démarrage de Windows, l'ISO démarrera en BIOS et en UEFI. Sinon, ce sera une image de données."/>
          <TextBlock Text="Source" Style="{StaticResource TxtLabel}"/>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="BtnIsoSrc" DockPanel.Dock="Right" Content="Choisir" Margin="8,0,0,0"/>
            <TextBox x:Name="IsoSrc" Tag="Dossier, ou lettre d'une clé (ex. E:\)"/>
          </DockPanel>
          <TextBlock Text="Fichier ISO à créer" Style="{StaticResource TxtLabel}"/>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="BtnIsoOut" DockPanel.Dock="Right" Content="Choisir" Margin="8,0,0,0"/>
            <TextBox x:Name="IsoOut" Tag="Emplacement du fichier"/>
          </DockPanel>
          <TextBlock Text="Nom du volume" Style="{StaticResource TxtLabel}"/>
          <TextBox x:Name="IsoLabel" Text="OPTIWIN" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <CheckBox x:Name="ChkNoPrompt" Content="Démarrage direct, sans « Appuyez sur une touche » (si la source le permet)" Margin="0,0,0,18"/>
          <Button x:Name="BtnMakeIso" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Padding="20,10">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoDisc}"/><TextBlock Text="Créer l'ISO" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ═══════ ISO personnalisée ═══════ -->
    <ScrollViewer x:Name="PanelCustom" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Grid Margin="32,0,32,28" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Image de départ" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,14" Text="L'ISO d'origine n'est jamais modifiée. Comptez 20 à 60 minutes, et une vingtaine de Go d'espace libre."/>
            <TextBlock Text="ISO officielle de Windows" Style="{StaticResource TxtLabel}"/>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="BtnCustSrc" DockPanel.Dock="Right" Content="Parcourir" Margin="8,0,0,0"/>
              <TextBox x:Name="CustSrc" Tag="Fichier .iso" IsReadOnly="True"/>
            </DockPanel>
            <TextBlock Text="Édition à conserver" Style="{StaticResource TxtLabel}"/>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="BtnCustRead" DockPanel.Dock="Right" Content="Lire les éditions" Margin="8,0,0,0"/>
              <ComboBox x:Name="CustEdition"/>
            </DockPanel>
            <TextBlock Text="ISO à créer" Style="{StaticResource TxtLabel}"/>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="BtnCustOut" DockPanel.Dock="Right" Content="Choisir" Margin="8,0,0,0"/>
              <TextBox x:Name="CustOut" Tag="Emplacement du fichier"/>
            </DockPanel>
            <TextBlock Text="Dossier de travail temporaire" Style="{StaticResource TxtLabel}"/>
            <DockPanel>
              <Button x:Name="BtnCustWork" DockPanel.Dock="Right" Content="Choisir" Margin="8,0,0,0"/>
              <TextBox x:Name="CustWork"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Personnalisation" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
            <CheckBox x:Name="CustBloat" IsChecked="True" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="Retirer les applications préinstallées inutiles" Style="{StaticResource TxtBody}"/><TextBlock Text="Elles ne seront jamais installées sur le nouveau Windows." Style="{StaticResource TxtSmall}"/></StackPanel>
            </CheckBox>
            <CheckBox x:Name="CustDrivers" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="Intégrer les pilotes de ce PC" Style="{StaticResource TxtBody}"/><TextBlock Text="Pour réinstaller ce même PC : réseau et stockage fonctionnent dès le premier démarrage." Style="{StaticResource TxtSmall}"/></StackPanel>
            </CheckBox>
            <CheckBox x:Name="CustBypass" Content="Autoriser les PC non compatibles Windows 11" Margin="0,0,0,10"/>
            <CheckBox x:Name="CustAcct" Content="Sans compte Microsoft ni Internet obligatoires" Margin="0,0,0,10"/>
            <CheckBox x:Name="CustNoBitlocker" Content="Ne pas chiffrer automatiquement le disque" Margin="0,0,0,10"/>
            <CheckBox x:Name="CustPrivacy" Content="Refuser d'emblée les options de collecte de données" Margin="0,0,0,10"/>
            <CheckBox x:Name="CustOpti" Content="Inclure OptiWin dans l'image" IsChecked="True" Margin="0,0,0,18"/>
            <Button x:Name="BtnCustGo" Style="{StaticResource BtnPrimary}" Padding="20,11">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoPlay}"/><TextBlock Text="Générer l'ISO" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- ═══════ Multiboot ═══════ -->
    <ScrollViewer x:Name="PanelMulti" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Grid Margin="32,0,32,28" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Plusieurs images sur une seule clé" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,14" Text="Windows, Linux, outils de secours : au démarrage, un menu vous laisse choisir. Pour en ajouter plus tard, il suffit de copier le fichier sur la clé."/>
            <Button x:Name="BtnMultiAdd" HorizontalAlignment="Left" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoFolder}"/><TextBlock Text="Ajouter des images" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <ItemsControl x:Name="MultiList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,4">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Command="{Binding Remove}" Style="{StaticResource BtnGhost}" ToolTip="Retirer de la liste" Padding="6,4"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoX}"/></Button>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource TxtSmall}" VerticalAlignment="Center" Margin="10,0"/>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="MultiTotal" Style="{StaticResource TxtSmall}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Button x:Name="BtnMultiRefresh" DockPanel.Dock="Right" ToolTip="Actualiser" Padding="10,8"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/></Button>
              <TextBlock Text="Destination" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
            </DockPanel>
            <RadioButton x:Name="MultiNew" Style="{StaticResource ChoiceCard}" GroupName="MultiMode" IsChecked="True" Margin="0,0,0,6">
              <StackPanel><TextBlock Text="Préparer une nouvelle clé" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/><TextBlock Text="Efface la clé et y installe Ventoy." Style="{StaticResource TxtSmall}"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="MultiExisting" Style="{StaticResource ChoiceCard}" GroupName="MultiMode" Margin="0,0,0,12">
              <StackPanel><TextBlock Text="Compléter une clé Ventoy existante" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/><TextBlock Text="Ajoute les images sans rien effacer." Style="{StaticResource TxtSmall}"/></StackPanel>
            </RadioButton>
            <StackPanel x:Name="MultiNewBox">
              <TextBlock Text="Clé USB" Style="{StaticResource TxtLabel}"/>
              <ComboBox x:Name="MultiDisk" Margin="0,0,0,10"/>
              <CheckBox x:Name="MultiGpt" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="Partitionnement GPT" Style="{StaticResource TxtBody}"/><TextBlock Text="Laissez décoché pour démarrer aussi sur les vieux PC (MBR)." Style="{StaticResource TxtSmall}"/></StackPanel>
              </CheckBox>
            </StackPanel>
            <StackPanel x:Name="MultiExistingBox" Visibility="Collapsed">
              <TextBlock Text="Clé Ventoy" Style="{StaticResource TxtLabel}"/>
              <ComboBox x:Name="MultiKey" Margin="0,0,0,12"/>
            </StackPanel>
            <Button x:Name="BtnMultiGo" Style="{StaticResource BtnDanger}" FontSize="14" Padding="14,11">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoUsb}"/><TextBlock Text="Lancer" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <TextBlock x:Name="MultiInfo" Style="{StaticResource TxtSmall}" Margin="0,8,0,0" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- ═══════ Télécharger ═══════ -->
    <ScrollViewer x:Name="PanelDownload" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <StackPanel Margin="32,0,32,28">
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Télécharger Windows depuis Microsoft" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,14" Text="Image officielle, listée dans le catalogue du Media Creation Tool et lue en HTTPS sur les serveurs de Microsoft. Elle est contrôlée à l'arrivée, puis transformée en ISO prête pour une clé."/>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Version" Style="{StaticResource TxtLabel}"/>
                <ComboBox x:Name="DlProduct"/>
              </StackPanel>
              <Button x:Name="BtnDlRead" Grid.Column="1" Content="Lire le catalogue" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
              <StackPanel Grid.Column="3">
                <TextBlock Text="Langue" Style="{StaticResource TxtLabel}"/>
                <ComboBox x:Name="DlLang"/>
              </StackPanel>
              <StackPanel Grid.Column="5">
                <TextBlock Text="Architecture" Style="{StaticResource TxtLabel}"/>
                <ComboBox x:Name="DlArch"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="DlInfo" Style="{StaticResource TxtSmall}" Margin="0,0,0,12"/>
            <TextBlock Text="ISO à créer" Style="{StaticResource TxtLabel}"/>
            <DockPanel Margin="0,0,0,12">
              <Button x:Name="BtnDlOut" DockPanel.Dock="Right" Content="Choisir" Margin="8,0,0,0"/>
              <TextBox x:Name="DlOut" Tag="Emplacement du fichier"/>
            </DockPanel>
            <CheckBox x:Name="DlHomePro" IsChecked="True" Margin="0,0,0,14">
              <StackPanel><TextBlock Text="Ne garder que les éditions Famille et Pro" Style="{StaticResource TxtBody}"/><TextBlock Text="ISO plus légère, plus vite créée." Style="{StaticResource TxtSmall}"/></StackPanel>
            </CheckBox>
            <Button x:Name="BtnDlGo" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Padding="20,10" IsEnabled="False">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoDownload}"/><TextBlock Text="Télécharger et créer l'ISO" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource TxtLabel}" Margin="2,0,0,8" Text="Sites officiels, à ouvrir dans votre navigateur"/>
        <ItemsControl x:Name="LinkList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding Open}" Margin="0,0,8,8" Padding="16,12" HorizontalContentAlignment="Stretch" Background="{DynamicResource Surface}">
                <DockPanel>
                  <Path DockPanel.Dock="Right" Style="{StaticResource IcoSm}" Data="{StaticResource IcoDownload}" Margin="12,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmall}"/>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════ Vérifier ═══════ -->
    <ScrollViewer x:Name="PanelHash" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="32,0,32,28" MaxWidth="760" MinWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Vérifier une image téléchargée" Style="{StaticResource TxtH2}"/>
          <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,16" Text="Comparez l'empreinte SHA-256 du fichier à celle publiée par l'éditeur : si elles sont identiques, le fichier est intact et authentique."/>
          <TextBlock Text="Fichier" Style="{StaticResource TxtLabel}"/>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="BtnHashFile" DockPanel.Dock="Right" Content="Parcourir" Margin="8,0,0,0"/>
            <TextBox x:Name="HashFile" IsReadOnly="True" Tag="Fichier à vérifier"/>
          </DockPanel>
          <TextBlock Text="Empreinte attendue (facultatif)" Style="{StaticResource TxtLabel}"/>
          <TextBox x:Name="HashExpected" Tag="Collez ici l'empreinte SHA-256 de l'éditeur" Margin="0,0,0,16"/>
          <Button x:Name="BtnHashGo" Style="{StaticResource BtnPrimary}" Content="Calculer" HorizontalAlignment="Left" Padding="20,9"/>
          <TextBlock x:Name="HashResult" Style="{StaticResource TxtBody}" FontFamily="{StaticResource FontMono}" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</DockPanel>
