<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <BooleanToVisibilityConverter x:Key="BoolVis"/>

