<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
    <TextBlock Text="Nettoyer" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,14" Text="Seuls les caches et fichiers que Windows recrée au besoin. Jamais vos documents ni vos téléchargements."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <RadioButton x:Name="TabClean" Style="{StaticResource Pill}" GroupName="CleanTabs" Content="Nettoyage" IsChecked="True"/>
      <RadioButton x:Name="TabAnalyze" Style="{StaticResource Pill}" GroupName="CleanTabs" Content="Où est passé mon espace ?"/>
    </StackPanel>
  </StackPanel>

  <Grid>
  <!-- Nettoyage -->
  <Grid x:Name="PanelClean">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnSelectAll" Style="{StaticResource BtnGhost}" Content="Tout cocher" ToolTip="Coche tout ce qui peut l'être sans perte définitive" Margin="0,0,2,0"/>
            <Button x:Name="BtnSelectNone" Style="{StaticResource BtnGhost}" Content="Tout décocher" Margin="0,0,10,0"/>
            <Button x:Name="BtnScan" Margin="0,0,8,0" ToolTip="F5">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Analyser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="BtnClean" Style="{StaticResource BtnPrimary}" Padding="18,8" IsEnabled="False">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoSpark}"/><TextBlock Text="Nettoyer la sélection" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CleanTotal" Text="—" Style="{StaticResource TxtMetric}"/>
            <TextBlock x:Name="CleanSub" Text="Lancez l'analyse pour mesurer l'espace récupérable." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="CleanList" Margin="32,0,32,28">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="4,0,16,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TxtRow}"/>
                    <TextBlock Text="{Binding Desc}" Style="{StaticResource TxtSmall}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource TxtSmallAuto}" Foreground="{DynamicResource Accent}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel><ContentPresenter/><ItemsPresenter/></StackPanel>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtLabel}" Margin="2,10,0,7"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ItemsControl.GroupStyle>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <!-- Analyse de l'espace -->
  <Grid x:Name="PanelAnalyze" Visibility="Collapsed">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="16,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <ComboBox x:Name="DriveCombo" Width="190" Margin="0,0,8,0"/>
            <Button x:Name="BtnAnalyze" Style="{StaticResource BtnPrimary}" Content="Analyser" Margin="0,0,8,0"/>
            <Button x:Name="BtnUp" IsEnabled="False">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoBack}"/><TextBlock Text="Remonter" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="AnalyzePath" Style="{StaticResource TxtSmall}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </Border>
      <ProgressBar x:Name="AnalyzeBar" DockPanel.Dock="Top" IsIndeterminate="True" Margin="32,0,32,10" Visibility="Collapsed" Height="3"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="AnalyzeList" Margin="32,0,32,28">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}" Margin="0,0,0,4" Padding="14,9" HorizontalContentAlignment="Stretch" Background="{DynamicResource Surface}" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <Path x:Name="I" Style="{StaticResource IcoSm}" Data="{StaticResource IcoFolder}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TxtBody}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="2" Value="{Binding Share}" Maximum="100" Margin="12,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFile}" Value="True"><Setter TargetName="I" Property="Data" Value="{StaticResource IcoFile}"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
  </Grid>
</DockPanel>
