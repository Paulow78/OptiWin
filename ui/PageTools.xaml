<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="32,22,32,32">
    <TextBlock Text="Outils" Style="{StaticResource TxtTitle}"/>
    <TextBlock Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,18" Text="Réparer, diagnostiquer, préparer une réinstallation."/>

    <ItemsControl x:Name="ToolList" Margin="0,0,-10,8">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16">
            <DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Lancer" Command="{Binding Cmd}" IsEnabled="{Binding CanRun}" Padding="13,5"/>
                <TextBlock Text="{Binding Duration}" Style="{StaticResource TxtSmall}" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
              </DockPanel>
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,11,0">
                    <Path Style="{StaticResource Ico}" Data="{Binding IconGeo}" TextElement.Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource TxtRow}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Desc}" Style="{StaticResource TxtSmall}" Margin="0,8,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="BtnDnsTest" DockPanel.Dock="Right" Content="Mesurer" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
            <TextBlock Text="Le DNS le plus rapide pour votre connexion" Style="{StaticResource TxtH2}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="DnsCurrent" Style="{StaticResource TxtSmall}" Margin="0,0,0,12"/>
          <ItemsControl x:Name="DnsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource TxtSmall}"><Run Text="{Binding Primary, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Note, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                  <TextBlock x:Name="Ms" Grid.Column="1" Text="{Binding MsText}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                  <Button Grid.Column="2" Content="Utiliser" Command="{Binding Use}" Padding="11,4" VerticalAlignment="Center"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsBest}" Value="True"><Setter TargetName="Ms" Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="BtnDnsRestore" Content="Revenir au réglage d'origine" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-8,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Ce PC peut-il passer à Windows 11 ?" Style="{StaticResource TxtH2}" Margin="0,0,0,12"/>
          <ItemsControl x:Name="Win11List">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Style="{StaticResource LevelDot}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TxtSmall}"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Modes d'alimentation Windows -->
    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnPowerUltimate" Style="{StaticResource BtnGhost}" Margin="0,0,6,0" ToolTip="Ajoute le mode caché « Performances optimales » de Windows sans rien modifier d'autre">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoZap}"/><TextBlock Text="Débloquer Performances optimales" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="BtnPowerRefresh" Padding="10,6" ToolTip="Actualiser les modes d'alimentation">
              <Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Mode d'alimentation Windows" Style="{StaticResource TxtH2}"/>
            <TextBlock Style="{StaticResource TxtSmall}" Text="Basculez en un clic entre Économie, Équilibré, Performances élevées ou Performances optimales. 100 % réversible."/>
          </StackPanel>
        </DockPanel>
        <ItemsControl x:Name="PowerPlanList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="CardB" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,10,8">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button Content="{Binding StateLabel}" Command="{Binding Activate}" IsEnabled="{Binding CanActivate}" Padding="11,4"/>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="CardB" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="CardB" Property="Background" Value="{DynamicResource AccentSoft}"/>
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Préférences et mises à jour -->
    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnReleases" Style="{StaticResource BtnGhost}" Margin="0,0,6,0" ToolTip="Ouvre la page des versions sur GitHub">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoExternal}"/><TextBlock Text="Notes de version" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="BtnCheckUpdate" Style="{StaticResource BtnPrimary}" Padding="16,8">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Rechercher une mise à jour" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AboutVersion" Text="OptiTech" Style="{StaticResource TxtH2}"/>
          <TextBlock Style="{StaticResource TxtSmall}" Margin="0,2,0,8" Text="Les nouvelles versions sont publiées sur GitHub. Chaque mise à jour est téléchargée en HTTPS et son empreinte SHA-256 contrôlée avant de remplacer l'exécutable."/>
          <CheckBox x:Name="ChkAutoUpdate" Content="Rechercher une nouvelle version au lancement, une fois par jour au plus" Margin="0,0,0,6"/>
          <CheckBox x:Name="ChkLightweight" Content="Mode léger : couper le verre liquide, le flou et les animations (idéal sur vieux PC ou bureau à distance)"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
