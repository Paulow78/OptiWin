<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
    <TextBlock Text="Applications" Style="{StaticResource TxtTitle}"/>
    <TextBlock x:Name="Sub" Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,14" Text="Retirez ce qui encombre, installez l'essentiel en une fois."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <RadioButton x:Name="TabRemove" Style="{StaticResource Pill}" GroupName="AppTabs" Content="Retirer" IsChecked="True"/>
      <RadioButton x:Name="TabInstall" Style="{StaticResource Pill}" GroupName="AppTabs" Content="Installer"/>
    </StackPanel>
  </StackPanel>

  <Grid>
  <Grid x:Name="PanelRemove">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,12">
        <DockPanel>
          <Button x:Name="BtnRemove" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Retirer la sélection" Padding="18,8" IsEnabled="False"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RemoveInfo" Text="Recherche des applications installées…" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
            <TextBlock Text="Toujours réinstallables depuis le Microsoft Store. Le Store et les composants système ne sont jamais proposés." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="RemoveList" Margin="32,0,32,28">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Row}" Margin="0,0,6,6">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmallAuto}"/>
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <Grid x:Name="PanelInstall" Visibility="Collapsed">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,12">
        <DockPanel>
          <Button x:Name="BtnInstall" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Installer la sélection" Padding="18,8" IsEnabled="False"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="InstallInfo" Text="Choisissez vos logiciels" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallNote" Text="Téléchargés depuis les sources officielles via winget. Installer un logiciel vaut acceptation de la licence de son éditeur." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="InstallGroups" Margin="32,0,32,28">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Key}" Style="{StaticResource TxtLabel}" Margin="2,0,0,7"/>
                <ItemsControl ItemsSource="{Binding Value}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Row}" Margin="0,0,6,6" Padding="13,10">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmallAuto}" FontSize="11"/>
                          </StackPanel>
                        </CheckBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
  </Grid>
</DockPanel>
