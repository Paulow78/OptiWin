<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
    <TextBlock Text="Applications" Style="{StaticResource TxtTitle}"/>
    <TextBlock x:Name="Sub" Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,14" Text="Retirez ce qui encombre, installez l'essentiel en une fois."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <RadioButton x:Name="TabRemove" Style="{StaticResource Pill}" GroupName="AppTabs" Content="Retirer" IsChecked="True"/>
      <RadioButton x:Name="TabInstall" Style="{StaticResource Pill}" GroupName="AppTabs" Content="Installer"/>
      <RadioButton x:Name="TabUpgrade" Style="{StaticResource Pill}" GroupName="AppTabs" Content="Mettre à jour"/>
    </StackPanel>
  </StackPanel>

  <Grid>
  <Grid x:Name="PanelRemove">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,12">
        <DockPanel>
          <Button x:Name="BtnRemove" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Retirer la sélection" Padding="18,8" IsEnabled="False"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RemoveInfo" Text="Recherche des applications installées…" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
            <TextBlock Text="Toujours réinstallables depuis le Microsoft Store. Le Store et les composants système ne sont jamais proposés." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="RemoveList" Margin="32,0,32,28">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Row}" Margin="0,0,6,6">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmallAuto}"/>
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <Grid x:Name="PanelInstall" Visibility="Collapsed">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnInstallNone" Style="{StaticResource BtnGhost}" Content="Tout décocher" Margin="0,0,6,0" Visibility="Collapsed"/>
            <Button x:Name="BtnInstall" Style="{StaticResource BtnPrimary}" Content="Installer la sélection" Padding="18,8" IsEnabled="False"/>
          </StackPanel>
          <TextBox x:Name="InstallSearch" DockPanel.Dock="Right" Width="210" Margin="12,0" VerticalAlignment="Center" Tag="Rechercher un logiciel (Ctrl+F)"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="InstallInfo" Text="Choisissez vos logiciels" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallNote" Text="Téléchargés depuis les sources officielles via winget. Installer un logiciel vaut acceptation de la licence de son éditeur." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="InstallGroups" Margin="32,0,32,28">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Key}" Style="{StaticResource TxtLabel}" Margin="2,0,0,7"/>
                <ItemsControl ItemsSource="{Binding Value}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Row}" Margin="0,0,6,6" Padding="13,10">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource TxtSmallAuto}" FontSize="11"/>
                          </StackPanel>
                        </CheckBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <!-- Mettre à jour via winget -->
  <Grid x:Name="PanelUpgrade" Visibility="Collapsed">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnUpgradeAll" Style="{StaticResource BtnGhost}" Content="Tout cocher" Margin="0,0,2,0"/>
            <Button x:Name="BtnUpgradeNone" Style="{StaticResource BtnGhost}" Content="Tout décocher" Margin="0,0,8,0"/>
            <Button x:Name="BtnUpgradeScan" Margin="0,0,8,0" ToolTip="F5">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Rechercher" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="BtnUpgradeRun" Style="{StaticResource BtnPrimary}" Padding="18,8" IsEnabled="False">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoArrowUp}"/><TextBlock Text="Mettre à jour" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="UpgradeInfo" Text="Cliquez sur Rechercher pour vérifier vos logiciels" Style="{StaticResource TxtBody}" FontWeight="SemiBold"/>
            <TextBlock x:Name="UpgradeNote" Text="Utilise winget pour vérifier et installer les mises à jour depuis les sources officielles." Style="{StaticResource TxtSmall}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid>
        <ItemsControl x:Name="UpgradeList" Style="{StaticResource VirtList}" Padding="32,0,32,28">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="4,0,14,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtRow}"/>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource TxtSmall}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource ChipBase}" Background="{DynamicResource AccentSoft}" Padding="9,3">
                    <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Accent}"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="UpgradeEmpty" Style="{StaticResource TxtEmpty}" VerticalAlignment="Top" Margin="0,42,0,0"/>
      </Grid>
    </DockPanel>
  </Grid>
  </Grid>
</DockPanel>
