<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel DockPanel.Dock="Top" Margin="32,22,32,16">
    <Button x:Name="BtnRefresh" DockPanel.Dock="Right" VerticalAlignment="Bottom">
      <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Actualiser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <StackPanel>
      <TextBlock Text="Démarrage" Style="{StaticResource TxtTitle}"/>
      <TextBlock x:Name="Sub" Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,0" Text="Même mécanisme que le Gestionnaire des tâches : rien n'est supprimé, tout se réactive d'un clic."/>
    </StackPanel>
  </DockPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <ItemsControl x:Name="List" Margin="32,0,32,28">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Row}" ToolTip="{Binding Command}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtRow}" Margin="0,0,9,0"/>
                  <Border Style="{StaticResource ChipBase}" Background="{DynamicResource WarnSoft}" Margin="0,1,0,0" Visibility="{Binding OftenUseless, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Souvent superflu" Style="{StaticResource ChipText}" Foreground="{DynamicResource Warn}"/>
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Meta}" Style="{StaticResource TxtSmall}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              </StackPanel>
              <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" Margin="18,0,0,0" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</DockPanel>
