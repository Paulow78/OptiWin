<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="32,22,32,14">
    <DockPanel>
      <Button x:Name="BtnRefresh" DockPanel.Dock="Right" VerticalAlignment="Bottom" ToolTip="F5">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Actualiser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="Démarrage" Style="{StaticResource TxtTitle}"/>
        <TextBlock x:Name="Sub" Style="{StaticResource TxtMuted}" FontSize="14" Margin="0,4,0,0" Text="Même mécanisme que le Gestionnaire des tâches : rien n'est supprimé, tout se réactive d'un clic."/>
      </StackPanel>
    </DockPanel>
    <DockPanel Margin="0,14,0,0">
      <Button x:Name="BtnUseless" DockPanel.Dock="Right" Content="Couper les superflus" IsEnabled="False" Margin="8,0,0,0"
              ToolTip="Désactive d'un coup tous les programmes marqués « souvent superflu » : lanceurs de jeux, mises à jour automatiques, messageries… Chacun se réactive d'un clic."/>
      <TextBox x:Name="Search" Width="260" HorizontalAlignment="Left" Tag="Filtrer par nom ou éditeur (Ctrl+F)"/>
    </DockPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,0,32,28">
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Row}" ToolTip="{Binding Command}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtRow}" Margin="0,0,9,0"/>
                    <Border Style="{StaticResource ChipBase}" Background="{DynamicResource WarnSoft}" Margin="0,1,0,0" Visibility="{Binding OftenUseless, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="Souvent superflu" Style="{StaticResource ChipText}" Foreground="{DynamicResource Warn}"/>
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource TxtSmall}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource BtnIcon}" Command="{Binding RevealCmd}" ToolTip="Ouvrir l'emplacement du programme" Visibility="{Binding CanReveal, Converter={StaticResource BoolVis}}">
                    <Path Style="{StaticResource IcoSm}" Data="{StaticResource IcoExternal}"/>
                  </Button>
                  <ToggleButton Style="{StaticResource Switch}" Margin="12,0,0,0" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="EmptyText" Style="{StaticResource TxtEmpty}"/>
    </StackPanel>
  </ScrollViewer>
</DockPanel>
